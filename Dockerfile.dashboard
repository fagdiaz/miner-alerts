FROM python:3.12-slim

WORKDIR /app

COPY app/stability_profile.py /app/app/stability_profile.py
COPY tools/operations_dashboard.py /app/tools/operations_dashboard.py

ENTRYPOINT ["python", "/app/tools/operations_dashboard.py"]
CMD ["--db", "/data/miner_alerts.db", "--out", "/out/index.html", "--hours", "24"]
